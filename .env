# Environment variables for POD Designer

# Backend
PORT=4000
NODE_ENV=production
CORS_ORIGIN=*

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pod_designer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# S3/MinIO
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=pod-designer

# Measurement Service
MEASUREMENT_SERVICE_URL=http://measurement-service:8000

# Backend URL (for worker)
BACKEND_URL=http://backend:4000

# Worker Configuration
WORKER_CONCURRENCY=2
LOG_LEVEL=info
