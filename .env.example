# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flash
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/flash

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO/S3 Configuration
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=measurements
S3_REGION=us-east-1

# Backend Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Measurement Service Configuration
MEASUREMENT_SERVICE_URL=http://measurement-service:8001
